---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout title="待办清单" description="简单的任务管理工具">
  <div class="space-y-6">
    <!-- Add Task -->
    <div class="flex gap-3">
      <input
        id="todo-input"
        type="text"
        class="input-field flex-1"
        placeholder="添加新任务..."
        autofocus
      />
      <button id="btn-add" class="btn-primary whitespace-nowrap">添加</button>
    </div>

    <!-- Stats -->
    <div class="flex gap-4 text-sm font-mono">
      <span class="text-text-muted">总计: <span id="total-count" class="text-text-primary">0</span></span>
      <span class="text-text-muted">已完成: <span id="done-count" class="text-green-400">0</span></span>
      <span class="text-text-muted">待办: <span id="pending-count" class="text-cyan">0</span></span>
    </div>

    <!-- Filter -->
    <div class="flex gap-2">
      <button data-filter="all" class="filter-btn px-3 py-1.5 rounded-lg text-sm font-mono border border-cyan/30 text-cyan bg-cyan/10">全部</button>
      <button data-filter="pending" class="filter-btn px-3 py-1.5 rounded-lg text-sm font-mono border border-border text-text-muted">待办</button>
      <button data-filter="done" class="filter-btn px-3 py-1.5 rounded-lg text-sm font-mono border border-border text-text-muted">已完成</button>
      <div class="flex-1"></div>
      <button id="btn-clear-done" class="px-3 py-1.5 rounded-lg text-sm font-mono border border-border text-text-muted hover:border-red-500/30 hover:text-red-400 transition-colors">清除已完成</button>
    </div>

    <!-- Task List -->
    <div id="todo-list" class="space-y-2"></div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-12 text-text-muted">
      <p class="text-lg mb-1">暂无任务</p>
      <p class="font-mono text-sm">在上方输入框添加新任务</p>
    </div>
  </div>
</ToolLayout>

<script>
  interface Todo {
    id: number;
    text: string;
    done: boolean;
    createdAt: number;
  }

  let todos: Todo[] = JSON.parse(localStorage.getItem('todos') || '[]');
  let filter: 'all' | 'pending' | 'done' = 'all';
  let nextId = todos.length > 0 ? Math.max(...todos.map((t) => t.id)) + 1 : 1;

  const input = document.getElementById('todo-input') as HTMLInputElement;
  const list = document.getElementById('todo-list')!;
  const emptyState = document.getElementById('empty-state')!;
  const totalCount = document.getElementById('total-count')!;
  const doneCount = document.getElementById('done-count')!;
  const pendingCount = document.getElementById('pending-count')!;

  function save() {
    localStorage.setItem('todos', JSON.stringify(todos));
  }

  function updateStats() {
    const total = todos.length;
    const done = todos.filter((t) => t.done).length;
    totalCount.textContent = String(total);
    doneCount.textContent = String(done);
    pendingCount.textContent = String(total - done);
  }

  function render() {
    const filtered = todos.filter((t) => {
      if (filter === 'pending') return !t.done;
      if (filter === 'done') return t.done;
      return true;
    });

    emptyState.style.display = filtered.length === 0 ? 'block' : 'none';

    list.innerHTML = filtered.map((todo) => `
      <div class="flex items-center gap-3 p-4 rounded-xl bg-bg-secondary/80 backdrop-blur-md border border-border transition-all duration-300 ${todo.done ? 'opacity-60' : ''}" data-id="${todo.id}">
        <button class="todo-toggle w-5 h-5 rounded border-2 flex-shrink-0 flex items-center justify-center transition-all duration-200 ${todo.done ? 'border-green-500 bg-green-500/20 text-green-400' : 'border-border hover:border-cyan'}">
          ${todo.done ? '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>' : ''}
        </button>
        <span class="flex-1 text-sm ${todo.done ? 'line-through text-text-muted' : 'text-text-primary'}">${escapeHtml(todo.text)}</span>
        <button class="todo-delete text-text-muted hover:text-red-400 transition-colors p-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    `).join('');

    // Attach events
    list.querySelectorAll('.todo-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number((btn.closest('[data-id]') as HTMLElement).dataset.id);
        const todo = todos.find((t) => t.id === id);
        if (todo) {
          todo.done = !todo.done;
          save();
          updateStats();
          render();
        }
      });
    });

    list.querySelectorAll('.todo-delete').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number((btn.closest('[data-id]') as HTMLElement).dataset.id);
        todos = todos.filter((t) => t.id !== id);
        save();
        updateStats();
        render();
      });
    });

    updateStats();
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function addTodo() {
    const text = input.value.trim();
    if (!text) return;
    todos.push({ id: nextId++, text, done: false, createdAt: Date.now() });
    input.value = '';
    save();
    render();
  }

  document.getElementById('btn-add')!.addEventListener('click', addTodo);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') addTodo();
  });

  // Filters
  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = (btn as HTMLElement).dataset.filter as 'all' | 'pending' | 'done';
      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('border-cyan/30', 'text-cyan', 'bg-cyan/10');
        b.classList.add('border-border', 'text-text-muted');
      });
      btn.classList.remove('border-border', 'text-text-muted');
      btn.classList.add('border-cyan/30', 'text-cyan', 'bg-cyan/10');
      render();
    });
  });

  // Clear done
  document.getElementById('btn-clear-done')!.addEventListener('click', () => {
    todos = todos.filter((t) => !t.done);
    save();
    render();
  });

  // Initial render
  render();
</script>
