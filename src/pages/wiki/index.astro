---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const entries = (await getCollection('wiki'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(entries.map((entry) => entry.data.category))];

const categoryColors: Record<string, string> = {
  '前端': 'cyan',
  '后端': 'purple',
  '工具': 'pink-500',
};
---

<BaseLayout title="知识库" description="系统性的笔记与速查手册">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="text-purple">#</span> 知识库
      </h1>
      <p class="text-text-muted text-lg">系统性的笔记与速查手册</p>
    </div>

    <!-- Categories -->
    <div class="space-y-12">
      {categories.map((category) => {
        const categoryEntries = entries.filter((e) => e.data.category === category);
        const color = categoryColors[category] || 'cyan';
        return (
          <section>
            <h2 class={`text-2xl font-bold mb-6 text-${color}`}>
              {category}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {categoryEntries.map((entry) => (
                <Card href={`/wiki/${entry.id}`}>
                  <div class="flex flex-col h-full">
                    <div class="flex items-center gap-2 mb-3">
                      <span class={`w-2 h-2 rounded-full bg-${color}`}></span>
                      <span class="text-xs font-mono text-text-muted">{entry.data.tags.join(', ')}</span>
                    </div>
                    <h3 class="text-lg font-semibold text-text-primary mb-2">{entry.data.title}</h3>
                    <p class="text-text-secondary text-sm flex-1">{entry.data.description}</p>
                  </div>
                </Card>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    {entries.length === 0 && (
      <div class="text-center py-20 text-text-muted">
        <p class="text-2xl mb-2">知识库建设中</p>
        <p class="font-mono text-sm">敬请期待</p>
      </div>
    )}
  </div>
</BaseLayout>
