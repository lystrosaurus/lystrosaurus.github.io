---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import TagFilter from '../../components/TagFilter.astro';
import { categoryColor } from '@/utils/category';

const entries = (await getCollection('wiki'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const categories = [...new Set(entries.map((entry) => entry.data.category))];

// Unique, sorted list of every tag used across the knowledge base.
const allTags = [...new Set(entries.flatMap((entry) => entry.data.tags))].sort();
---

<BaseLayout title="知识库" description="系统性的笔记与速查手册">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="text-purple">#</span> 知识库
      </h1>
      <p class="text-text-muted text-lg">系统性的笔记与速查手册</p>
    </div>

    <!-- Tag Filter -->
    <TagFilter tags={allTags} />

    <!-- Categories -->
    <div class="space-y-12 mt-10">
      {categories.map((category) => {
        const categoryEntries = entries.filter((e) => e.data.category === category);
        const color = categoryColor(category);
        return (
          <section>
            <h2
              class="text-2xl font-bold mb-6 flex items-center gap-2"
              style={`color:${color}`}
            >
              <span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style={`background:${color}`}
              ></span>
              {category}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {categoryEntries.map((entry) => (
                <Card
                  href={`/wiki/${entry.id}`}
                  class="wiki-card"
                  data-category={entry.data.category}
                  data-tags={entry.data.tags.join(',')}
                >
                  <div class="flex flex-col h-full">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="text-xs font-mono text-text-muted">{entry.data.tags.join(', ')}</span>
                    </div>
                    <h3 class="text-lg font-semibold text-text-primary mb-2">{entry.data.title}</h3>
                    <p class="text-text-secondary text-sm flex-1">{entry.data.description}</p>
                  </div>
                </Card>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    {entries.length === 0 && (
      <div class="text-center py-20 text-text-muted">
        <p class="text-2xl mb-2">知识库建设中</p>
        <p class="font-mono text-sm">敬请期待</p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip[data-tag]');
  const cards = document.querySelectorAll<HTMLElement>('.wiki-card[data-tags]');

  function applyFilter(active: string): void {
    cards.forEach((card) => {
      const tags = (card.dataset.tags || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean);
      const matched = active === '' || tags.includes(active);
      card.classList.toggle('hidden', !matched);
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const active = chip.dataset.tag || '';
      chips.forEach((c) => c.classList.remove('tag-chip-active'));
      chip.classList.add('tag-chip-active');
      applyFilter(active);
    });
  });
</script>
