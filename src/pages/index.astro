---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import TagCloud from '../components/TagCloud.astro';

const skills = [
  { name: 'TypeScript', color: 'cyan' as const },
  { name: 'JavaScript', color: 'yellow' as const },
  { name: 'Python', color: 'cyan' as const },
  { name: 'Go', color: 'cyan' as const },
  { name: 'React', color: 'cyan' as const },
  { name: 'Vue', color: 'green' as const },
  { name: 'Astro', color: 'purple' as const },
  { name: 'Node.js', color: 'green' as const },
  { name: 'Docker', color: 'cyan' as const },
  { name: 'Kubernetes', color: 'cyan' as const },
  { name: 'PostgreSQL', color: 'cyan' as const },
  { name: 'Redis', color: 'pink' as const },
  { name: 'Linux', color: 'yellow' as const },
  { name: 'Git', color: 'pink' as const },
];

const recentPosts = [
  {
    title: '欢迎来到全新的个人站',
    description: '关于本站重构的一些思考与技术选型分享',
    date: '2026-05-14',
    href: '/blog/welcome',
    tags: ['Astro', '前端'],
  },
  {
    title: 'Astro 静态站点最佳实践',
    description: '从零开始构建一个现代化的静态博客',
    date: '2026-05-10',
    href: '/blog/astro-best-practices',
    tags: ['Astro', 'SSG'],
  },
  {
    title: '终端工作流优化指南',
    description: '我的命令行配置与提效技巧',
    date: '2026-05-05',
    href: '/blog/terminal-workflow',
    tags: ['Terminal', 'Productivity'],
  },
];

const quickNav = [
  {
    title: '博客',
    description: '技术文章、思考与生活记录',
    icon: '📝',
    href: '/blog',
    color: 'cyan',
  },
  {
    title: '知识库',
    description: '系统性的笔记与速查手册',
    icon: '📚',
    href: '/wiki',
    color: 'purple',
  },
  {
    title: '工具',
    description: '开发工具集与实用小工具',
    icon: '🛠',
    href: '/tools',
    color: 'pink',
  },
];
---

<BaseLayout title="首页">
  <!-- Hero Section -->
  <section class="relative min-h-[calc(100vh-4rem)] flex items-center overflow-hidden">
    <!-- Background grid -->
    <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
    <!-- Background glow -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan/10 rounded-full blur-3xl animate-glow-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple/10 rounded-full blur-3xl animate-glow-pulse" style="animation-delay: 1s;"></div>

    <div class="relative max-w-6xl mx-auto px-4 py-20 w-full">
      <div class="flex flex-col items-center text-center gap-8">
        <!-- Avatar -->
        <div class="relative animate-float">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan to-purple rounded-full blur-xl opacity-50"></div>
          <div class="relative w-32 h-32 rounded-full bg-bg-secondary border-2 border-cyan/50 flex items-center justify-center shadow-glow-cyan">
            <span class="text-5xl font-bold neon-text font-mono">F</span>
          </div>
        </div>

        <!-- Name -->
        <h1 class="text-5xl md:text-7xl font-bold">
          <span class="bg-gradient-to-r from-cyan via-purple to-pink-500 bg-clip-text text-transparent">
            Hello, I'm Fatty
          </span>
        </h1>

        <!-- Typewriter Tagline -->
        <div class="font-mono text-xl md:text-2xl text-text-secondary h-8">
          <span class="inline-block typewriter">&gt; Software Engineer · Open Source Enthusiast</span>
          <span class="inline-block w-0.5 h-6 bg-cyan ml-1 animate-blink align-middle"></span>
        </div>

        <!-- Description -->
        <p class="max-w-2xl text-text-muted text-lg leading-relaxed">
          这里是我的数字花园，记录学习笔记、技术思考与开源项目。
          欢迎在博客、知识库与工具集中漫游。
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/blog" class="btn-primary">
            <span>阅读博客</span>
            <span class="ml-2">→</span>
          </a>
          <a href="/tools" class="btn-secondary">
            <span>探索工具</span>
            <span class="ml-2">🛠</span>
          </a>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
          <svg class="w-6 h-6 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">
          <span class="text-cyan">#</span> 技术栈
        </h2>
        <p class="text-text-muted">我熟悉与正在学习的一些技术</p>
      </div>
      <TagCloud tags={skills} />
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section class="py-20 px-4 bg-bg-secondary/30">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-3">
            <span class="text-purple">#</span> 最近文章
          </h2>
          <p class="text-text-muted">近期的写作与分享</p>
        </div>
        <a href="/blog" class="text-cyan hover:underline font-mono text-sm hidden md:inline-block">
          查看全部 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <Card href={post.href}>
            <div class="flex flex-col h-full">
              <time class="text-xs text-text-muted font-mono mb-2">{post.date}</time>
              <h3 class="text-xl font-semibold text-text-primary mb-3 line-clamp-2">{post.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed flex-1 line-clamp-3">{post.description}</p>
              <div class="flex flex-wrap gap-2 mt-4">
                {post.tags.map((tag) => (
                  <span class="text-xs font-mono px-2 py-0.5 rounded bg-cyan/10 text-cyan">#{tag}</span>
                ))}
              </div>
            </div>
          </Card>
        ))}
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="/blog" class="text-cyan hover:underline font-mono text-sm">
          查看全部 →
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Navigation Section -->
  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">
          <span class="text-pink-500">#</span> 探索
        </h2>
        <p class="text-text-muted">选择一个入口开始</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickNav.map((nav) => (
          <Card href={nav.href} class="text-center p-8">
            <div class="text-6xl mb-4">{nav.icon}</div>
            <h3 class="text-2xl font-bold text-text-primary mb-2">{nav.title}</h3>
            <p class="text-text-muted text-sm">{nav.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .typewriter {
    overflow: hidden;
    white-space: nowrap;
    animation: typewriter 3s steps(45) 0.5s 1 normal both;
  }

  @keyframes typewriter {
    from { width: 0; }
    to { width: 100%; }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bg-grid-pattern {
    background-image:
      linear-gradient(rgba(0, 255, 242, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 242, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }
</style>
