---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title="博客" description="技术文章、思考与生活记录">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        <span class="text-cyan">#</span> 博客
      </h1>
      <p class="text-text-muted text-lg">技术文章、思考与生活记录</p>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-10">
      {allTags.map((tag) => (
        <span class="text-xs font-mono px-3 py-1.5 rounded-full bg-bg-secondary border border-border text-text-secondary hover:border-cyan/40 hover:text-cyan cursor-pointer transition-all duration-300">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Posts List -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <Card href={`/blog/${post.id}`}>
          <div class="flex flex-col h-full">
            <time class="text-xs text-text-muted font-mono mb-3">{post.data.date}</time>
            <h2 class="text-xl font-semibold text-text-primary mb-3 line-clamp-2">{post.data.title}</h2>
            <p class="text-text-secondary text-sm leading-relaxed flex-1 line-clamp-3">{post.data.description}</p>
            <div class="flex flex-wrap gap-2 mt-4">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-cyan/10 text-cyan">#{tag}</span>
              ))}
            </div>
          </div>
        </Card>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-20 text-text-muted">
        <p class="text-2xl mb-2">暂无文章</p>
        <p class="font-mono text-sm">稍后再来看看吧</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
