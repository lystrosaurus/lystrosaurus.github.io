---
interface Tag {
  name: string;
  color?: 'cyan' | 'purple' | 'pink' | 'green' | 'yellow';
}

interface Props {
  tags: Tag[];
  title?: string;
}

const { tags, title } = Astro.props;

const colorClasses = {
  cyan: 'border-cyan/40 text-cyan hover:bg-cyan/10 hover:shadow-glow-cyan',
  purple: 'border-purple/40 text-purple hover:bg-purple/10 hover:shadow-glow-purple',
  pink: 'border-pink-500/40 text-pink-400 hover:bg-pink-500/10',
  green: 'border-green-500/40 text-green-400 hover:bg-green-500/10',
  yellow: 'border-yellow-500/40 text-yellow-400 hover:bg-yellow-500/10',
};
---

<div>
  {title && <h3 class="text-lg font-semibold text-text-primary mb-4">{title}</h3>}
  <div class="flex flex-wrap gap-3">
    {tags.map((tag) => (
      <span
        class:list={[
          'inline-block px-4 py-2 rounded-full border bg-bg-secondary/50 backdrop-blur-sm font-mono text-sm transition-all duration-300 cursor-default hover:-translate-y-0.5',
          colorClasses[tag.color || 'cyan'],
        ]}
      >
        {tag.name}
      </span>
    ))}
  </div>
</div>
