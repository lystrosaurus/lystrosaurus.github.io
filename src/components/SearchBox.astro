---
/**
 * Persistent search box used in the site header. Submitting navigates to the
 * global /search page, forwarding the current query as the `?q=` parameter.
 */
---

<form id="header-search-form" class="hidden md:flex items-center" role="search">
  <div class="relative">
    <input
      type="text"
      name="q"
      class="input-field w-48 py-2 pl-9 pr-3 text-sm"
      placeholder="搜索..."
      aria-label="搜索"
    />
    <svg
      class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
    </svg>
  </div>
</form>

<script>
  const form = document.getElementById('header-search-form');
  form?.addEventListener('submit', (e: Event) => {
    e.preventDefault();
    const input = form.querySelector('input') as HTMLInputElement;
    const q = input.value.trim();
    location.href = q ? `/search?q=${encodeURIComponent(q)}` : '/search';
  });
</script>
