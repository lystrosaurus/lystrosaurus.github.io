.bc-card {
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-radius: 20rpx;
  padding: 26rpx;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.bc-hover {
  background: #1a1a1a;
  border-color: #00fff2;
}
.bc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f2f2f2;
  line-height: 1.35;
}
.bc-meta {
  font-size: 22rpx;
  color: #8a8a8a;
  margin-top: 6rpx;
}
.bc-summary {
  font-size: 24rpx;
  color: #b8b8b8;
  margin-top: 14rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.bc-footer {
  margin-top: auto;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bc-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.bc-done {
  color: #6ee7b7;
  font-size: 20rpx;
}
.bc-pending {
  color: #c8a96a;
  font-size: 20rpx;
}
