<view class="page">
  <view class="prof-head">我的</view>

  <!-- 阅读设置 -->
  <view class="card glass-card">
    <view class="card-title">阅读设置</view>

    <view class="row">
      <text class="row-label">默认字号</text>
      <view class="row-ctrl">
        <view class="ctrl-btn" bindtap="changeFont" data-d="-1">A−</view>
        <text class="ctrl-val">{{fontSize}}</text>
        <view class="ctrl-btn" bindtap="changeFont" data-d="1">A＋</view>
      </view>
    </view>

    <view class="row">
      <text class="row-label">阅读主题</text>
      <view class="theme-switch {{theme==='dark'?'on-dark':'on-light'}}" bindtap="toggleTheme">
        {{theme === 'dark' ? '暗色' : '浅色'}}
      </view>
    </view>
  </view>

  <!-- 数据同步 -->
  <view class="card glass-card">
    <view class="card-title">数据同步</view>
    <view class="row">
      <text class="row-label">书目总数</text>
      <text class="row-val">{{bookCount}} 本</text>
    </view>
    <view class="row">
      <text class="row-label">最近同步</text>
      <text class="row-val">{{lastSync}}</text>
    </view>
    <view class="row">
      <text class="row-label">数据来源</text>
      <text class="row-val">{{sourceText}}</text>
    </view>
    <view class="sync-btn btn-primary" bindtap="syncNow">立即同步</view>
    <view class="sync-note">数据由静态站点（books.ts）单一真相源构建，同步后即时一致。</view>
  </view>

  <!-- 关于 -->
  <view class="card glass-card">
    <view class="card-title">关于</view>
    <view class="about">
      智识花园 · 书库小程序是静态站点书籍模块的阅读端，迁移了书库浏览、书籍详情、结构化阅读（字体/进度/书签）与书架管理，并与站点共享同一份萃取数据。
    </view>
    <view class="about-link" bindtap="clearCache">清除本地缓存</view>
  </view>
</view>
