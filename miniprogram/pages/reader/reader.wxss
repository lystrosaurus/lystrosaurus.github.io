.reader-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 暗色（默认，与站点一致） */
.theme-dark {
  background: #0a0a0a;
  color: #d8d8d8;
}
/* 浅色护眼 */
.theme-light {
  background: #f3efe6;
  color: #2a2620;
}

.reader-scroll {
  flex: 1;
  height: 0;
}
.reader-inner {
  padding: 28rpx 30rpx 0;
}

.reader-book-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  opacity: 0.9;
}
.theme-light .reader-book-title {
  color: #1a1712;
}

.r-block {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid #1f1f1f;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}
.theme-light .r-block {
  background: #ffffff;
  border-color: #e2dccd;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.r-block.bm {
  border-color: #00fff2;
}

.r-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.r-type-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #00fff2;
}
.theme-light .r-type-label {
  color: #0b8f87;
}

.bm-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  color: #555;
  font-size: 30rpx;
}
.bm-btn.bm-on {
  color: #ffcf5c;
}

.kp-tag {
  display: inline-block;
  font-size: 18rpx;
  color: #06231f;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}

.r-body {
  color: inherit;
}

/* 底部控制栏 */
.reader-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(17, 17, 17, 0.97);
  border-top: 1rpx solid #2a2a2a;
}
.theme-light .reader-bar {
  background: rgba(243, 239, 230, 0.97);
  border-top-color: #e2dccd;
}
.bar-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #e8e8e8;
  padding: 12rpx 0;
  border-radius: 12rpx;
}
.theme-light .bar-btn {
  color: #2a2620;
}
.bar-font {
  flex: 0 0 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #00fff2;
}
.bar-progress {
  flex: 0 0 90rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8a8a;
}
.bm-list {
  color: #ffcf5c;
}

/* 书签面板 */
.bm-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}
.bm-panel {
  width: 100%;
  background: #141414;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
}
.bm-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  color: #f2f2f2;
  margin-bottom: 16rpx;
}
.bm-close {
  color: #8a8a8a;
  font-size: 32rpx;
  padding: 0 10rpx;
}
.bm-scroll {
  max-height: 56vh;
}
.bm-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #222;
}
.bm-dot {
  color: #ffcf5c;
  margin-right: 16rpx;
}
.bm-text {
  font-size: 28rpx;
  color: #e0e0e0;
}
