.detail-header {
  padding: 12rpx 0 24rpx;
}
.detail-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #f5f5f5;
  line-height: 1.3;
}
.detail-meta {
  font-size: 24rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.para {
  font-size: 28rpx;
  color: #cfcfcf;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.section {
  margin-top: 36rpx;
}

.level-group {
  margin-bottom: 12rpx;
}
.level-head {
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  margin: 18rpx 0 12rpx;
}
.level-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 12rpx;
}

.kp-card {
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
}
.kp-level {
  display: inline-block;
  font-size: 18rpx;
  color: #06231f;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 10rpx;
}
.kp-concept {
  font-size: 30rpx;
  font-weight: 700;
  color: #f2f2f2;
  margin-bottom: 8rpx;
}
.kp-detail {
  font-size: 26rpx;
  color: #bdbdbd;
  line-height: 1.75;
}

.list {
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 8rpx 22rpx;
}
.list-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1e1e1e;
}
.list-item:last-child {
  border-bottom: none;
}
.bullet {
  color: #00fff2;
  margin-right: 14rpx;
  line-height: 1.6;
}
.list-body {
  flex: 1;
  font-size: 26rpx;
  color: #bdbdbd;
  line-height: 1.75;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.grid-item {
  display: flex;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(17, 17, 17, 0.96);
  border-top: 1rpx solid #2a2a2a;
  backdrop-filter: blur(12rpx);
}
.shelf-btn {
  flex: 0 0 240rpx;
  background: #1a1a1a;
  border: 1rpx solid #333;
  border-radius: 999rpx;
  color: #e8e8e8;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 0;
}
.shelf-on {
  border-color: #6ee7b7;
  color: #6ee7b7;
}
.read-btn {
  flex: 1;
}
