.shelf-head {
  font-size: 34rpx;
  font-weight: 800;
  color: #f2f2f2;
  margin-bottom: 24rpx;
}
.shelf-item {
  display: flex;
  align-items: stretch;
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.shelf-info {
  flex: 1;
  min-width: 0;
}
.shelf-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f2f2f2;
}
.shelf-meta {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.bar {
  height: 10rpx;
  background: #1e1e1e;
  border-radius: 999rpx;
  margin: 16rpx 0 10rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #00fff2, #20c4b8);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.shelf-foot {
  font-size: 20rpx;
}
.shelf-actions {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  margin-left: 18rpx;
}
.read-now {
  background: rgba(0, 255, 242, 0.12);
  color: #00fff2;
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}
.remove-btn {
  color: #8a8a8a;
  font-size: 28rpx;
  padding: 6rpx 14rpx;
}
.go-books {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 40rpx;
}
