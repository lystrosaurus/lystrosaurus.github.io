/* app.wxss — 全局样式（暗色科技风，对齐静态站点设计系统） */
page {
  background: #0a0a0a;
  color: #e8e8e8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 玻璃拟态卡片 */
.glass-card {
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.45);
}
.glass-card-hover {
  background: #1a1a1a;
  border-color: #00fff2;
}

.accent-text {
  color: #00fff2;
}
.muted {
  color: #8a8a8a;
}
.dim {
  color: #6a6a6a;
}

/* 主色强调条 */
.accent-bar {
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #00fff2, #a855f7);
  margin-right: 14rpx;
  vertical-align: -4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f2f2f2;
  margin: 40rpx 0 20rpx;
  display: flex;
  align-items: center;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #00fff2, #20c4b8);
  color: #062b29;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
}
.btn-ghost {
  background: #1a1a1a;
  color: #e8e8e8;
  border: 1rpx solid #333;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 分类标签 */
.cat-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.badge-done {
  color: #6ee7b7;
  font-size: 20rpx;
}
.badge-pending {
  color: #c8a96a;
  font-size: 20rpx;
}

/* 引用块 */
.blockquote {
  border-left: 6rpx solid #00fff2;
  background: rgba(0, 255, 242, 0.06);
  padding: 20rpx 24rpx;
  border-radius: 0 14rpx 14rpx 0;
  color: #d8f7f4;
  font-style: italic;
}

/* 富文本内联样式（mdToNodes 输出） */
.md-strong {
  color: #ffffff;
  font-weight: 700;
}
.md-code {
  font-family: "JetBrains Mono", Menlo, Consolas, monospace;
  background: #0d0d0d;
  border: 1rpx solid #2a2a2a;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  color: #a855f7;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #8a8a8a;
  padding: 80rpx 40rpx;
}
.empty-title {
  font-size: 34rpx;
  color: #c8a96a;
  display: block;
  margin-bottom: 12rpx;
}
